# Server-only environment template. Edit a private .env on the server.
# Do not overwrite your existing local .env or paste credentials into chat.
DOMAIN=
PUBLIC_BASE_URL=
BOT_MODE=serve
X_POSTING_ENABLED=false
WEB_HOST=0.0.0.0
WEB_PORT=3001
DATA_DIR=/app/data
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BOT_USER_ID=
X_CALLBACK_URL=http://127.0.0.1:3000/callback
X_PAYMENT_CARDS=false
# Private Testnet mode. Operator controls and verified recovery gate native wallet access.
ZCASH_NETWORK=testnet
PRIVATE_TIPPING_ENABLED=true
# X_USER_CALLBACK_URL defaults to PUBLIC_BASE_URL/account/callback
MAX_TIP_ZEC=1
REQUEST_TTL_HOURS=24
DAILY_X_BUDGET_USD=1.00
MAX_REPLIES_PER_RUN=1
MAX_REPLIES_PER_DAY=10
MAX_MENTION_PAGES=3
MAX_X_CALLS_PER_RUN=30
POLL_INTERVAL_SECONDS=60
HOSTED_WALLETS_ENABLED=false
WALLET_ACCOUNTS_ENABLED=false

