# Enter the EXISTING app's API key and API key secret locally. Never paste them in chat.
X_API_KEY=
X_API_SECRET=
# Filled by npm run auth ONLY after @zectipbot is verified.
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BOT_USER_ID=
# Register this EXACT callback in the existing app's OAuth 1.0a settings.
X_CALLBACK_URL=http://127.0.0.1:3000/callback
# Live writes require both this setting and npm run bot:live.
X_POSTING_ENABLED=false
# HTTPS URL of the payment page server, e.g. your temporary tunnel URL. No trailing path.
PUBLIC_BASE_URL=http://127.0.0.1:3001
WEB_HOST=127.0.0.1
WEB_PORT=3001
ZCASH_NETWORK=testnet
MAX_TIP_ZEC=1
REQUEST_TTL_HOURS=24
# Conservative local estimates; X's console is the billing authority.
DAILY_X_BUDGET_USD=1.00
X_USAGE_GUARD_ENABLED=true
MAX_REPLIES_PER_RUN=3
MAX_REPLIES_PER_DAY=10
MAX_MENTION_PAGES=3
MAX_X_CALLS_PER_RUN=30

# Automatic worker: minimum 30 seconds; 60 seconds is the default.
POLL_INTERVAL_SECONDS=60

# Include branded PNG payment cards. If media access is denied, replies fall back to the text link.
X_PAYMENT_CARDS=false

# Optional persistent-state location; default data preserves the local setup.
DATA_DIR=data

# Private Testnet mode. Native account setup and spending start disabled.
PRIVATE_TIPPING_ENABLED=true
BOT_MODE=serve
WALLET_ACCOUNTS_ENABLED=false
HOSTED_WALLETS_ENABLED=false
# The existing X app must allow this ADDITIONAL exact public callback.
# X_USER_CALLBACK_URL=https://YOUR_HOSTNAME/account/callback
# Optional Linux loopback-only read-only wallet capability probe. Enter credentials locally.
# ZALLET_RPC_URL=http://127.0.0.1:28232
# ZALLET_RPC_USER=
# ZALLET_RPC_PASSWORD=

# User sign-in only: OAuth 2.0 confidential Web App credentials, not the bot API key.
# Enable OAuth 2.0 alongside OAuth 1.0a and register PUBLIC_BASE_URL/account/callback.
# No write, email, DM or offline scopes are requested. Enter values privately.
X_USER_CLIENT_ID=
X_USER_CLIENT_SECRET=
